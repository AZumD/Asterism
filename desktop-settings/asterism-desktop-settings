#!/usr/bin/env bash
# Launch Asterism Desktop Settings into the nested Plasma session.
# Host wrapper pattern from FrameTop display-settings/ft-display-settings +
# session/ft-shell-env.sh (https://github.com/AZumD/frametop) — attach to
# asterism_nested Wayland/X11 when invoked from SSH or a plain tty.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)
# shellcheck disable=SC1091
. "$here/asterism-shell-env.sh"

if ! asterism_shell_env_attach; then
  cat >&2 <<'EOF'
Asterism Desktop Settings needs the nested Plasma desktop display.

Start (or wait for) asterism-desktop.service, then either:
  • open Applications → Asterism Desktop Settings inside the VR desktop, or
  • re-run: asterism-desktop-settings

From SSH this launcher attaches to …/asterism_nested (same idea as FrameTop's
plasmashell.env). If Plasma is not up yet: systemctl --user start asterism-desktop.service
EOF
  exit 1
fi

export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
exec python3 "$here/asterism_desktop_settings.py" "$@"
