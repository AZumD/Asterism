# Asterism — Linux-first text policy (Steam Frame / SteamOS).
# Prevents CRLF from breaking `set -euo pipefail` and shebangs.

* text=auto eol=lf

*.sh     text eol=lf
*.py     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.conf   text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.svg    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.txt    text eol=lf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.so     binary
*.a      binary
*.o      binary
*.bin    binary
*.zip    binary
*.gz     binary
*.xz     binary
